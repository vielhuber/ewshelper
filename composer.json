{
    "name": "vielhuber/ewshelper",
    "description": "Manage exchange contacts with a breeze.",
    "require": {
        "php": ">=8.1",
        "php-ews/php-ews": ">=1.0",
        "vielhuber/stringhelper": ">=1.0",
        "vlucas/phpdotenv": ">=1.0",
        "cweagans/composer-patches": "^2.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "vielhuber\\ewshelper\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true
        }
    },
    "extra": {
        "patches": {
            "jamesiarmes/php-ntlm": {
                "PHP 8.5 fixes": "patches/jamesiarmes-php-ntlm-php85.patch"
            },
            "php-ews/php-ews": {
                "PHP 8.5 fixes": "patches/php-ews-php85-fixes.patch"
            }
        }
    }
}
