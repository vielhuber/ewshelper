{
    "name": "vielhuber/ewshelper",
    "description": "Manage exchange contacts with a breeze.",
    "require": {
        "php": ">=8.1",
        "php-ews/php-ews": ">=1.0",
        "vielhuber/stringhelper": "^7.4.2",
        "vlucas/phpdotenv": "^5.6.4",
        "cweagans/composer-patches": "^2.0.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "vielhuber\\ewshelper\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true
        }
    },
    "extra": {
        "patches": {
            "jamesiarmes/php-ntlm": {
                "PHP 8.5 fixes": "https://raw.githubusercontent.com/vielhuber/ewshelper/main/patches/jamesiarmes-php-ntlm-php85.patch"
            },
            "php-ews/php-ews": {
                "PHP 8.5 fixes": "https://raw.githubusercontent.com/vielhuber/ewshelper/main/patches/php-ews-php85-fixes.patch"
            }
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13"
    }
}